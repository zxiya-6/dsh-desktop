# pnpm 10 默认不跑依赖的构建脚本，必须放行，否则 node-pty/koffi 等静默缺原生二进制
dangerously-allow-all-builds=true

# dsh 内核安装（.pnpmrc 模板会带上这些镜像）：
# node-pty / sharp 等的原始二进制走国内镜像，避免 GitHub 拉取失败后回退 node-gyp
node-pty_binary_host_mirror=https://registry.npmmirror.com/-/binary/node-pty
sharp_binary_host=https://registry.npmmirror.com/-/binary/sharp
sharp_libvips_binary_host=https://registry.npmmirror.com/-/binary/sharp-libvips
sharp_dist_base_url=https://registry.npmmirror.com/-/binary/sharp
